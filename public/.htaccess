# Evita cache do index.html para que o navegador sempre pegue os chunks corretos após deploy.
# Sem isso, index antigo em cache pode pedir .js com hash antigo (404).
<FilesMatch "index\.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Assets com hash no nome podem ser cacheados por muito tempo
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "max-age=31536000, immutable"
</FilesMatch>
